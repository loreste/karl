{
  "version": "0.5.0",

  "ng_protocol": {
    "enabled": true,
    "udp_port": 22222,
    "timeout": 30
  },

  "transport": {
    "udp_enabled": true,
    "udp_port": 12000,
    "tcp_enabled": false,
    "tcp_port": 12001,
    "tls_enabled": false,
    "ipv6_enabled": false,
    "mtu": 1500
  },

  "sessions": {
    "max_sessions": 10000,
    "session_ttl": 3600,
    "cleanup_interval": 60,
    "min_port": 30000,
    "max_port": 40000
  },

  "jitter_buffer": {
    "enabled": true,
    "min_delay": 20,
    "max_delay": 200,
    "target_delay": 50,
    "adaptive_mode": true,
    "max_size": 100
  },

  "rtcp": {
    "enabled": true,
    "interval": 5,
    "reduced_size": false,
    "mux_enabled": true
  },

  "fec": {
    "enabled": true,
    "block_size": 48,
    "redundancy": 0.30,
    "adaptive_mode": true,
    "max_redundancy": 0.50,
    "min_redundancy": 0.10
  },

  "rtp_settings": {
    "max_bandwidth": 2000,
    "min_jitter_buffer": 20,
    "packet_loss_threshold": 3,
    "encryption": true
  },

  "recording": {
    "enabled": false,
    "base_path": "/var/lib/karl/recordings",
    "format": "wav",
    "mode": "stereo",
    "sample_rate": 8000,
    "bits_per_sample": 16,
    "retention_days": 30
  },

  "api": {
    "enabled": true,
    "address": ":8080",
    "auth_enabled": false,
    "rate_limit_per_min": 120,
    "cors_enabled": false
  },

  "webrtc": {
    "enabled": false,
    "webrtc_port": 8443,
    "stun_servers": ["stun:stun.l.google.com:19302"],
    "max_bitrate": 2000000,
    "bw_estimation": true
  },

  "integration": {
    "media_ip": "auto",
    "public_ip": "",
    "keepalive_interval": 30
  },

  "database": {
    "mysql_dsn": "",
    "redis_enabled": false,
    "redis_addr": "localhost:6379",
    "redis_cleanup_interval": 3600
  },

  "srtp": {
    "srtp_key": "",
    "srtp_salt": ""
  },

  "alert_settings": {
    "packet_loss_threshold": 0.05,
    "jitter_threshold": 50.0,
    "bandwidth_threshold": 1000000,
    "notify_admin": false,
    "admin_email": ""
  }
}
